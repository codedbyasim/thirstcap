# ThirstCap talks to the optimizer only when both of these are set.
# Leave NEXT_PUBLIC_API_URL empty to run the built-in SAMPLE planner.
# The sample planner is labelled in the UI. It is not a backtest.

# NEXT_PUBLIC_API_URL=https://thirstcap-api.onrender.com
# Set to false only when NEXT_PUBLIC_API_URL points at the FastAPI service.
# NEXT_PUBLIC_USE_MOCK=true
