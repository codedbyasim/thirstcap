# ThirstCap frontend connects to the FastAPI + PuLP CBC MILP optimizer at NEXT_PUBLIC_API_URL.
# For local development, run the FastAPI backend on port 8000 and set:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=false

# For production on Vercel, point NEXT_PUBLIC_API_URL to your deployed Render backend origin (no trailing slash).
# Leave NEXT_PUBLIC_API_URL unset only if you want the offline fallback heuristic.
